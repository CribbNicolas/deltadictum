{
  "description": "DD delivery and capture for Grok Build inside this checkout: the hooks hooks/hooks.json registers, as a project-level configuration, run with --grok so Grok's payloads are read in their own shape. Failures never block the host.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs session-start --grok", "timeout": 30 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node ../../hooks/run.cjs prompt --grok", "timeout": 10 },
        { "type": "command", "command": "node ../../hooks/run.cjs observe-prompt --grok", "timeout": 10, "async": true }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob|read_file|search_replace|run_terminal_command|grep|list_dir",
        "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs pre-tool --grok", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob|read_file|search_replace|run_terminal_command|grep|list_dir",
        "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs observe --grok", "timeout": 10, "async": true } ] },
      { "matcher": "Write|Edit|MultiEdit|search_replace",
        "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs inbox --grok", "timeout": 30 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob|read_file|search_replace|run_terminal_command|grep|list_dir",
        "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs observe --grok", "timeout": 10, "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node ../../hooks/run.cjs stop --grok", "timeout": 10 } ] }
    ]
  }
}
