{
  "name": "deltadictum",
  "version": "0.3.0",
  "description": "DeltaDictum (DD): next-action doctrine for coding agents. Trigger + behavior_delta + evidence, not session memory.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "dd": "./src/cli.js",
    "deltadictum": "./src/cli.js"
  },
  "exports": {
    ".": "./adapters/opencode/index.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/engine/**/*.test.js\" \"tests/store/**/*.test.js\" \"tests/mcp/**/*.test.js\" \"tests/ui/**/*.test.js\" \"tests/hooks/**/*.test.js\" \"tests/semantic/**/*.test.js\"",
    "test:engine": "node --test --test-concurrency=1 \"tests/engine/**/*.test.js\"",
    "test:store": "node --test --test-concurrency=1 \"tests/store/**/*.test.js\"",
    "test:mcp": "node --test --test-concurrency=1 \"tests/mcp/**/*.test.js\"",
    "test:ui": "node --test --test-concurrency=1 \"tests/ui/**/*.test.js\"",
    "test:hooks": "node --test --test-concurrency=1 \"tests/hooks/**/*.test.js\"",
    "test:stress": "node --test --test-concurrency=1 \"tests/stress/**/*.test.js\"",
    "test:all": "npm test && npm run test:stress",
    "eval": "node src/eval/replay.js",
    "eval:models": "node src/eval/model-runner.js",
    "start": "node src/cli.js",
    "mcp": "node src/mcp/server.js",
    "bench": "node src/eval/bench/run.js --project=.",
    "bench:semantic": "node src/eval/bench/run.js --project=. --provider=semantic"
  },
  "files": [
    "src",
    ".claude-plugin",
    "adapters",
    "docs/DD.md",
    "docs/architecture",
    "docs/integrations",
    "docs/evaluation",
    "docs/memory",
    "skills",
    "hooks",
    "mcp.js",
    ".mcp.json",
    "scripts",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.0",
    "@huggingface/transformers": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CribbNicolas/deltadictum.git"
  },
  "homepage": "https://github.com/CribbNicolas/deltadictum#readme",
  "bugs": {
    "url": "https://github.com/CribbNicolas/deltadictum/issues"
  }
}
