{
  "name": "deltadictum",
  "version": "0.9.6",
  "description": "DeltaDictum (DD): the engineering knowledge your code does not show, delivered to coding agents at the action it applies to. Local, shared via git; a plugin for Claude Code, with Codex, Grok Build and OpenCode in progress.",
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "opencode",
    "coding-agents",
    "agent-memory"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "deltadictum": "src/cli.js"
  },
  "exports": {
    ".": "./adapters/opencode/index.js",
    "./server": "./adapters/opencode/index.js"
  },
  "scripts": {
    "test": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/engine/**/*.test.js\" \"tests/store/**/*.test.js\" \"tests/ui/**/*.test.js\" \"tests/hooks/**/*.test.js\" \"tests/skills/**/*.test.js\" \"tests/capture/**/*.test.js\" \"tests/maintenance/**/*.test.js\"",
    "test:engine": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/engine/**/*.test.js\"",
    "test:store": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/store/**/*.test.js\"",
    "test:ui": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/ui/**/*.test.js\"",
    "test:hooks": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/hooks/**/*.test.js\"",
    "test:stress": "node --import ./tests/helpers/isolate-data.js --test --test-concurrency=1 \"tests/stress/**/*.test.js\"",
    "test:all": "npm test && npm run test:stress",
    "lint": "npx --yes eslint@10.11.0 .",
    "start": "node src/cli.js",
    "bench:v2": "node src/eval/v2bench/run.js"
  },
  "files": [
    "src",
    "!src/eval",
    ".claude-plugin",
    "adapters",
    "docs/DD.md",
    "docs/guide",
    "docs/architecture",
    "docs/integrations",
    "skills",
    "hooks",
    "scripts",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CribbNicolas/deltadictum.git"
  },
  "homepage": "https://cribbnicolas.github.io/deltadictum/",
  "bugs": {
    "url": "https://github.com/CribbNicolas/deltadictum/issues"
  }
}
