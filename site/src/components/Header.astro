---
import pkg from '../../../package.json';
import Mark from './Mark.astro';
import Search from './Search.astro';
import { SITE, href } from '../config.js';

const { docs = false } = Astro.props;
---
<header class="site-header">
  <nav class:list={['bar', { wide: docs }]} aria-label="Site">
    <a class="brand" href={href('')}>
      <Mark />
      <span>DeltaDictum</span>
      {docs && <span class="version">{pkg.version}</span>}
    </a>
    {docs && <Search />}
    <div class="links">
      {!docs && <a href={href('getting-started.html')}>Docs</a>}
      {!docs && <a class="optional" href={href('guide/how-it-works.html')}>How it works</a>}
      <a href={SITE.repo}>GitHub</a>
      {docs ? <a href={SITE.npm}>npm</a> : <a class="cta" href={href('getting-started.html')}>Get started</a>}
    </div>
  </nav>
</header>
<style>
  .site-header { background: var(--bg); }
  .bar { max-width: var(--content); margin: 0 auto; padding: 18px var(--gutter); display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .bar.wide { max-width: 1360px; padding-block: 14px; border-bottom: 1px solid #161b22; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--text-heading); font-weight: 600; text-decoration: none; letter-spacing: -0.01em; }
  .version { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); border: 1px solid var(--border-3); border-radius: 999px; padding: 1px 8px; }
  .links { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; font-size: 14px; }
  .links a { color: var(--text-muted); text-decoration: none; }
  .links a:hover { color: var(--text-strong); }
  @media (max-width: 520px) {
    .bar { padding-top: 14px; padding-bottom: 14px; }
    .links { gap: 8px 16px; }
    .links a.optional { display: none; }
  }
  .links a.cta { background: var(--accent); color: var(--on-accent); font-weight: 600; padding: 0 14px; min-height: 44px; display: inline-flex; align-items: center; border-radius: var(--radius-s); }
</style>
