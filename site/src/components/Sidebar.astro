---
import { href } from '../config.js';
import { DEFAULT_HARNESS, HARNESSES } from '../lib/harness.js';
const { groups, current } = Astro.props;
---
<details class="sidebar" open data-sidebar>
  <summary>Menu</summary>
  <label class="harness">
    <span class="group-title">Harness</span>
    <select data-harness-select aria-label="Harness the docs describe">
      {HARNESSES.map(h => <option value={h.id} selected={h.id === DEFAULT_HARNESS}>{h.label}</option>)}
    </select>
  </label>
  <nav aria-label="Documentation">
    {groups.map(group => (
      <div class="group">
        <p class="group-title">{group.title}</p>
        <ul>
          {group.items.map(item => (
            <li><a href={href(item.href)} aria-current={item.id === current ? 'page' : undefined}>{item.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</details>
<script>
  import { currentHarness, setHarness } from '../lib/harness-client.js';
  // The docs follow one harness everywhere: the select changes it, and shows the one stored.
  for (const select of document.querySelectorAll('[data-harness-select]')) {
    select.addEventListener('change', () => setHarness(select.value));
  }
  setHarness(currentHarness());

  // On a narrow screen the menu is closed behind its summary; on a wide one, where the summary is
  // hidden, it must be open, also after a rotation or a resize. Without JavaScript it stays open.
  const sidebar = document.querySelector('[data-sidebar]');
  const narrow = matchMedia('(max-width: 959px)');
  const fit = () => { if (sidebar) sidebar.open = !narrow.matches; };
  fit();
  narrow.addEventListener('change', fit);
</script>
<style>
  .sidebar { padding: 32px 0; font-size: 14px; }
  summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; color: var(--text-heading); font-weight: 600; }
  @media (max-width: 959px) { .sidebar { padding: 8px 0 0; border-bottom: 1px solid var(--border-1); } .sidebar[open] { padding-bottom: 12px; } }
  @media (min-width: 960px) { summary { display: none; } }
  .harness { display: flex; flex-direction: column; gap: 8px; margin-bottom: 22px; }
  .harness .group-title { margin: 0; }
  select { min-height: 36px; padding: 0 10px; border: 1px solid var(--border-3); border-radius: var(--radius-s); background: var(--surface-2); color: var(--text-strong); font: inherit; }
  .group { margin-bottom: 22px; }
  .group-title { margin: 0 0 8px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  a { display: block; padding: 6px 10px; border-radius: var(--radius-s); color: var(--text); text-decoration: none; }
  a:hover { background: var(--surface-3); color: var(--text-strong); }
  a[aria-current='page'] { background: var(--accent); color: var(--on-accent); font-weight: 600; }
</style>
