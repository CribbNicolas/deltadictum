---
import { href } from '../../config.js';
const checks = ['No account, no model calls', 'Memories are files in your repo', 'Silent when nothing applies'];
const prompt = "add a test for the store's close() method";
---
<section class="hero wrap">
  <div class="copy">
    <p class="pill"><span class="live" aria-hidden="true"></span>Plugin for Claude Code · Codex and OpenCode in preview</p>
    <h1>What your code doesn't say, said at the right moment.</h1>
    <p class="lede">DeltaDictum keeps the decisions, traps and unwritten steps of your project as memories in git, and hands each one to the agent right before the tool call it applies to.</p>
    <div class="actions">
      <a class="btn btn-primary" href="#install">Get started</a>
      <a class="btn btn-ghost" href="#how">See how it works</a>
    </div>
    <ul class="checks">
      {checks.map(check => (
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gain)" stroke-width="2.4" aria-hidden="true"><path d="m5 12 5 5 9-10" /></svg>{check}</li>
      ))}
    </ul>
  </div>
  <figure class="terminal" data-terminal aria-label="A Claude Code session: DD adds a memory to the edit it applies to">
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>~/my-project — claude</span></div>
    <div class="screen">
      <div class="welcome">
        <p><span class="claude">✻</span> Welcome to <strong>Claude Code</strong>!</p>
        <p class="gray indent">cwd: ~/my-project</p>
      </div>
      <p class="tl gray" data-step="1">⎿  DD - 12 memories live in this project. Review UI: /dd:review</p>
      <p class="tl prompt" data-step="2">&gt; <span data-type>{prompt}</span><span class="caret typing" aria-hidden="true"></span></p>
      <div class="swap">
        <p class="tl" data-step="3" data-until="4"><span class="claude spin">✻</span> <span class="gray">Thinking…</span></p>
        <p class="tl" data-step="4"><span class="white">⏺</span> I'll add the test in tests/store.test.js.</p>
      </div>
      <p class="tl gap" data-step="5"><span class="green">⏺</span> <strong>Update</strong>(tests/store.test.js)</p>
      <div class="tl" data-step="6">
        <p class="gray">⎿  PreToolUse:Edit hook additional context:</p>
        <p class="gray nest">DD - project knowledge (tests/store.test.js):</p>
        <p class="nest memory">[TRAP] Close stores in t.after - A failing assertion otherwise leaves the handle open and node --test never ends.</p>
      </div>
      <div class="tl" data-step="7">
        <p class="gray">⎿  Updated tests/store.test.js with 3 additions</p>
        <p class="nest add">+  const store = openStore(dir);</p>
        <p class="nest add">+  t.after(() =&gt; store.close());</p>
      </div>
      <p class="tl gap" data-step="8"><span class="white">⏺</span> Done: the store closes in t.after, so a failing assertion can't hang node --test.</p>
      <div class="input" aria-hidden="true">&gt; <span class="caret"></span></div>
      <p class="hint" aria-hidden="true">? for shortcuts</p>
    </div>
  </figure>
</section>
<script>
  // The hero's session, step by step: 1 the DD line, 2 the prompt typed, 3 thinking, 4 the answer,
  // 5 the Update call, 6 DD's context, 7 the diff, 8 done; a pause, then again. Every line keeps its
  // place while hidden, so the page never moves. Without JavaScript, or with reduced motion asked for,
  // the whole session shows still.
  const terminal = document.querySelector('[data-terminal]');
  if (terminal && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines = [...terminal.querySelectorAll('[data-step]')];
    const typed = terminal.querySelector('[data-type]');
    const caret = terminal.querySelector('.typing');
    const prompt = typed.textContent;
    const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
    const show = step => { for (const line of lines) line.classList.toggle('on', Number(line.dataset.step) <= step && !(Number(line.dataset.until) <= step)); };
    terminal.classList.add('animated');
    const play = async () => {
      for (;;) {
        show(0); typed.textContent = ''; caret.hidden = true;
        await wait(500); show(1);
        await wait(900); show(2); caret.hidden = false;
        for (let n = 1; n <= prompt.length; n += 1) { typed.textContent = prompt.slice(0, n); await wait(38); }
        caret.hidden = true;
        for (const [step, ms] of [[3, 600], [4, 1300], [5, 800], [6, 900], [7, 1400], [8, 1100]]) { await wait(ms); show(step); }
        await wait(4200);
        show(0);
        await wait(700);
      }
    };
    play();
  }
</script>
<style>
  .hero { max-width: 1200px; padding-top: 88px; padding-bottom: 72px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .copy { flex: 1 1 460px; min-width: 0; }
  .pill { margin: 0 0 18px; display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px; border: 1px solid var(--border-3); border-radius: 999px; font: 500 12px/1.6 var(--font-mono); color: var(--text-muted); }
  .live { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--gain); }
  h1 { margin: 0; font-size: clamp(38px, 5.4vw, 56px); line-height: 1.04; letter-spacing: -0.035em; color: var(--text-strong); font-weight: 700; }
  .lede { margin: 22px 0 0; max-width: 540px; font-size: 18px; color: var(--text-muted); }
  .actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .actions .btn { border-radius: 10px; }
  .checks { margin: 28px 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; color: var(--text-muted); }
  .checks li { display: flex; align-items: center; gap: 8px; }

  .terminal { flex: 1 1 500px; min-width: 0; margin: 0; background: #101214; border: 1px solid #2a2e34; border-radius: 12px; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45); overflow: hidden; }
  .chrome { display: flex; align-items: center; gap: 8px; padding: 11px 16px; background: #15181c; border-bottom: 1px solid var(--border-1); font: 12px var(--font-mono); color: var(--text-faint); }
  .chrome i { flex: none; width: 11px; height: 11px; border-radius: 50%; background: #3a3f46; }
  .chrome span { margin: 0 auto; padding-right: 50px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .screen { padding: 18px 20px 20px; font: 13.5px/1.7 var(--font-mono); color: #d6d9de; overflow-wrap: anywhere; }
  .screen p { margin: 0; }
  .screen strong { font-weight: 600; color: var(--text-heading); }
  .welcome { padding: 10px 14px; border: 1px solid #d77757; border-radius: 8px; color: var(--text-heading); }
  .indent { margin-left: 18px !important; }
  .claude { display: inline-block; color: #d77757; }
  .gray { color: #8a8f98; }
  .white { color: var(--text-heading); }
  .green { color: #5fb672; }
  .memory { color: #b4b8bf; }
  .nest { margin-left: 36px !important; }
  .add { padding: 0 6px; background: rgba(95, 182, 114, 0.14); color: #b6e3bf; }
  [data-step='1'] { margin: 10px 0 0 2px !important; }
  .prompt { margin-top: 14px !important; padding: 2px 8px; border-radius: 4px; background: #23262b; color: #c4c8cf; min-height: 1.7em; }
  /* Thinking and the answer share one line: the answer replaces it. */
  .swap { margin-top: 14px; display: grid; }
  .swap > * { grid-area: 1 / 1; }
  [data-step='6'] { margin-top: 2px; }
  [data-step='7'] { margin-top: 6px; }
  .gap { margin-top: 12px !important; }
  .input { margin-top: 16px; padding: 7px 12px; border: 1px solid #4a4f57; border-radius: 8px; color: #8a8f98; }
  .hint { margin: 6px 0 0 4px !important; font-size: 12px; color: #8a8f98; }
  .caret { display: inline-block; width: 8px; height: 15px; margin-left: 2px; vertical-align: -2px; background: #c4c8cf; animation: caret 1s steps(1) infinite; }
  .caret[hidden] { display: none; }
  .spin { animation: spin 1.2s linear infinite; }
  .animated .tl { opacity: 0; transform: translateY(4px); transition: opacity 0.35s ease, transform 0.35s ease; }
  .animated .tl.on { opacity: 1; transform: none; }
  /* Still, the session shows its end: the answer, not the thinking it replaced. */
  .terminal:not(.animated) [data-until], .terminal:not(.animated) .typing { display: none; }
  @keyframes caret { 50% { opacity: 0; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .caret, .spin { animation: none; } }
  @media (max-width: 640px) {
    .hero { padding-top: 40px; padding-bottom: 48px; gap: 40px; }
    .lede { font-size: 17px; }
    .actions .btn { flex: 1 1 100%; justify-content: center; }
    .terminal { flex-basis: 100%; }
    .chrome span { padding-right: 0; margin-left: 8px; }
    .screen { padding: 14px 14px 16px; font-size: 11.5px; }
    .nest { margin-left: 20px !important; }
  }
</style>
