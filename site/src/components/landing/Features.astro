---
const FEATURES = [
  ['01 / TRIGGERS', 'Rules, not search', 'A memory names the files, symbols, commands or words it applies to. Only matches are delivered, once per session.'],
  ['02 / TIMING', 'At the action', 'Before the edit, before the command. A session that never touches those files never pays for it.'],
  ['03 / CAPTURE', 'Saved with evidence', 'After a fix or a correction, the agent proposes a memory. Verified evidence activates it; the rest waits for you.'],
  ['04 / LOCAL', 'Shared through git', 'JSON files in your repo. No account, no model calls, no background process, no dependencies.'],
];
---
<section class="band" aria-labelledby="features-title">
  <h2 id="features-title" class="visually-hidden">What DeltaDictum does</h2>
  <div class="grid wrap">
    {FEATURES.map(([tag, title, text]) => (
      <div class="cell"><p class="tag">{tag}</p><h3>{title}</h3><p>{text}</p></div>
    ))}
  </div>
</section>
<style>
  .band { border-top: 1px solid var(--border-1); border-bottom: 1px solid var(--border-1); background: var(--surface-1); }
  .grid { padding-top: 72px; padding-bottom: 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; background: var(--border-1); background-clip: content-box; }
  .cell { background: var(--surface-1); padding: 28px 24px; }
  .tag { margin: 0; font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
  h3 { margin: 12px 0 8px; font-size: 19px; color: var(--text-heading); font-weight: 600; }
  .cell p:last-child { margin: 0; font-size: 15px; color: var(--text-muted); }
</style>
