---
import { tableFor } from '../../lib/bench.js';
const { summary } = Astro.props;
const table = tableFor(summary);
---
<section class="measured wrap" aria-labelledby="measured-title">
  <p class="eyebrow">TABLE 1 · MEASURED</p>
  <h2 id="measured-title">{summary.title}</h2>
  <p class="sub">{summary.tasks} tasks, {summary.runs_per_condition} {summary.runs_per_condition === 1 ? 'run' : 'runs'} per condition, different models. {summary.note}</p>
  <div class="table">
    <table>
      <thead>
        <tr><th scope="col"><span class="visually-hidden">Metric</span></th>{table.columns.map(c => <th scope="col">{c.label}</th>)}</tr>
      </thead>
      <tbody>
        {table.rows.map(row => (
          <tr>
            <th scope="row">{row.label}</th>
            {row.cells.map((cell, i) => (
              <td class:list={{ base: table.columns[i].base, [cell.tone ?? '']: Boolean(cell.tone) }}>
                {cell.text}{cell.change && <span class="change">({cell.change})</span>}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="legend">Changes in parentheses are against the agent alone: points for percentages, share of the base for context and cost. <span class="first">Gold</span>: best in its row. <span class="second">Green</span>: second.</p>
</section>
<style>
  .measured { padding-top: 96px; padding-bottom: 96px; }
  h2 { margin: 0; font-size: clamp(28px, 4vw, 38px); letter-spacing: -0.025em; color: var(--text-strong); font-weight: 600; }
  .sub { margin: 10px 0 0; color: var(--text-muted); }
  .table { margin-top: 28px; overflow-x: auto; background: var(--surface-2); border: 1px solid var(--border-3); border-radius: var(--radius-m); }
  table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 880px; }
  th, td { padding: 13px 20px; text-align: left; border-bottom: 1px solid var(--border-1); }
  thead th { font-weight: 500; color: var(--text-muted); border-bottom-color: var(--border-3); }
  tbody th { font-weight: 400; color: var(--text); }
  tbody tr:last-child > * { border-bottom: 0; }
  td { font-family: var(--font-mono); color: var(--text-heading); white-space: nowrap; }
  td.base { color: var(--text); }
  .change { margin-left: 8px; color: var(--text-faint); font-weight: 400; }
  td.first, .legend .first { color: var(--accent); font-weight: 500; }
  td.second, .legend .second { color: var(--gain); font-weight: 500; }
  td.first .change, td.second .change { color: inherit; opacity: 0.8; }
  .legend { margin: 12px 0 0; font-size: 14px; color: var(--text-muted); }
</style>
