---
// The DeltaDictum mark: two capital Ds sharing a stem, drawn in the accent colour.
const { size = 26 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 128 128" aria-hidden="true">
  <g fill="none" stroke="var(--accent)" stroke-width="12" stroke-linejoin="round">
    <circle cx="64" cy="64" r="36" />
    <line x1="64" y1="28" x2="64" y2="100" stroke-linecap="square" />
  </g>
</svg>
