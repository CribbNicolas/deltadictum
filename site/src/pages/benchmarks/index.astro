---
import { getCollection, getEntry, render } from 'astro:content';
import Doc from '../../layouts/Doc.astro';
import { loadSummaries } from '../../lib/summaries.js';
import { tableFor } from '../../lib/bench.js';
import { routeFor } from '../../lib/routes.js';
import { href } from '../../config.js';

const page = await getEntry('docs', 'benchmarks/index');
const { Content, headings } = await render(page);
const summaries = loadSummaries();
const reports = new Set((await getCollection('docs')).map(p => p.id));
const trialHeadings = summaries.map(s => ({ depth: 2, slug: s.id, text: s.title }));
---
<Doc page={page} headings={[...headings, ...trialHeadings]}>
  <Content />
  {summaries.map(summary => {
    const table = tableFor(summary, { detail: true });
    const reportId = summary.report.replace(/\.md$/, '');
    return (
      <section class="trial">
        <h2 id={summary.id}>{summary.title}</h2>
        <p>{summary.date} · {summary.tasks} tasks · {summary.runs_per_condition} {summary.runs_per_condition === 1 ? 'run' : 'runs'} per condition · judged blind by {summary.judge}. Values with their 95% interval where the report has one; changes against {table.columns.find(c => c.base).label.toLowerCase()}.</p>
        <table>
          <thead><tr><th scope="col">Metric</th>{table.columns.map(c => <th scope="col">{c.label}</th>)}</tr></thead>
          <tbody>
            {table.rows.map(row => (
              <tr><th scope="row">{row.label}</th>
                {row.cells.map(cell => (
                  <td>{cell.text}{cell.ci && <span class="ci"> ({cell.ci})</span>}{cell.change && <span class:list={['change', { better: cell.better === true }]}> {cell.change}</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p>{summary.caveat} {reports.has(reportId) && <a href={href(routeFor(reportId))}>Full report</a>}</p>
      </section>
    );
  })}
</Doc>
<style>
  /* The interval and the change go under the value: four conditions fit beside the metric. */
  .ci { display: block; color: var(--text-faint); font-size: 0.9em; }
  .change { font-family: var(--font-mono); font-size: 0.9em; color: var(--text-muted); }
  .change.better { color: var(--accent); }
  td { white-space: nowrap; }
</style>
