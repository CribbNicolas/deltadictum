{
  "name": "deltadictum",
  "description": "DD v2 delivery and capture: the hooks hooks/hooks.json registers for Claude Code, assuming Claude Code's payload shape. Failures never block the host.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" session-start", "timeout": 30 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" prompt", "timeout": 10 },
        { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" observe-prompt", "timeout": 10, "async": true }
      ] }
    ],
    "PreToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob",
        "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" pre-tool", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob",
        "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" observe", "timeout": 10, "async": true } ] },
      { "matcher": "Write|Edit|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" inbox", "timeout": 30 } ] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep|Glob",
        "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" observe", "timeout": 10, "async": true } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "node \"${GROK_PLUGIN_ROOT}/hooks/run.cjs\" stop", "timeout": 10 } ] }
    ]
  }
}
